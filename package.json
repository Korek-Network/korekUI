{
  "name": "korek-miner-ui",
  "version": "0.2.2",
  "description": "KOREK Planck testnet desktop miner, hardware controller and reward wallet",
  "author": {
    "name": "KOREK Network",
    "email": "176841138+Korek-Network@users.noreply.github.com"
  },
  "homepage": "https://github.com/Korek-Network/korekUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Korek-Network/korekUI.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:windows": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "network.korek.miner",
    "productName": "KOREK Miner",
    "artifactName": "KOREK-Miner-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "KOREK Planck testnet miner and reward wallet",
      "maintainer": "KOREK Network <176841138+Korek-Network@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
